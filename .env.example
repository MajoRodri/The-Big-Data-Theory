# ═════════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - The Big Data Theory
#
# INSTRUCCIONES:
# 1. Copia este archivo como ".env" en la raíz del proyecto
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. NUNCA subas ".env" a Git (ya está en .gitignore)
# 4. ".env.example" SÍ se sube a Git (sin secrets)
# ═════════════════════════════════════════════════════════════════════════════

# WeatherAPI Configuration
# Obtén tu API key gratuita en: https://www.weatherapi.com/
# Plan gratuito: consultas limitadas por minuto
WEATHERAPI_API_KEY=tu_api_key_aqui
WEATHERAPI_BASE_URL=http://api.weatherapi.com/v1/current.json
WEATHERAPI_TIMEOUT_SEGUNDOS=5
WEATHERAPI_REINTENTOS=3

# Open-Meteo Configuration (sin API key requerida)
# Documentación: https://open-meteo.com/en/docs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ENABLED=false

# Scheduler Configuration
SCHEDULER_ENABLED=false
SCHEDULER_FRECUENCIA_MINUTOS=30
SCHEDULER_HORAS_ACTIVAS_DESDE=6
SCHEDULER_HORAS_ACTIVAS_HASTA=23

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_API_FILE=logs/api_requests.log

# Environment
ENV_MODE=development
